# PhyCool DevConsole — 環境變數範例
# 複製為 .env 並填入實際值（.env 不納入版本控制）

# Context Memory DB 路徑（相對於 tools/dev-console/）
# 預設: ../../.context-db/phycool.db
MEMORY_DB_PATH=../../.context-db/phycool.db

# PhyCool 專案根目錄（用於讀取 sprint-status.yaml 等檔案）
# 範例: /path/to/PhyCool-PCPT-MVP(Antigravity)
PROJECT_ROOT=../..

# Express API Server 監聽埠（預設: 3001）
PORT=3001
