        },
        "400": {
          "$type": "color",
          "$value": "#4ade80"
        },
        "500": {
          "$type": "color",
          "$value": "#22c55e"
        },
        "600": {
          "$type": "color",
          "$value": "#16a34a"
        },
        "700": {
