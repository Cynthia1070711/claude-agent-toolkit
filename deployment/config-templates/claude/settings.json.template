{
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:2",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "95",
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "MCP_TIMEOUT": "40000",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "PHYCOOL_RULE_VIOLATION_HINT_ENABLED": "true",
    "PHYCOOL_GODNODE_AUTO_REFRESH": "true",
    "PHYCOOL_PPR_ENABLED": "true"
  },
  "permissions": {
    "allow": [
      "Edit(.claude/**)",
      "Edit(.gemini/**)",
      "Edit(.agent/**)",
      "Bash(cp *skills*)",
      "Bash(ls *skills*)",
      "Bash(mkdir *skills*)",
      "Bash(mkdir .claude/*)",
      "Bash(mkdir .gemini/*)",
      "Bash(mkdir .agent/*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/appsettings.Development.json)",
      "Read(**/appsettings.Production.json)",
      "Read(**/credentials*)",
      "Read(**/secrets*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${PROJECT_ROOT}\" && node .claude/hooks/pre-commit-quality.js",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "cd \"${PROJECT_ROOT}\" && node .claude/hooks/pre-tool-bash-better-sqlite3-guard.js",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "cd \"${PROJECT_ROOT}\" && node .claude/hooks/tasks-backfill-review-audit-enforcer.js",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "cd \"${PROJECT_ROOT}\" && node .claude/hooks/tianji-baseline-snapshot-gate.js",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "cd \"${PROJECT_ROOT}\" && node .claude/hooks/tianji-concurrent-pilot-guard.js",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "cd \"${PROJECT_ROOT}\" && node .claude/hooks/tianji-q4-audit-gate.js",
            "timeout": 3000
