          {
            "type": "command",
            "command": "cd \"${PROJECT_ROOT}\" && node .claude/hooks/mcp-health-check.js",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "mcp__phycool-context__add_context",
