          {
            "type": "command",
            "command": "cd \"${PROJECT_ROOT}\" && node .claude/hooks/tianji-impulse-cooldown-guard.js",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${PROJECT_ROOT}\" && powershell -File scripts/file-lock-check.ps1 -AgentId CC-OPUS",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "cd \"${PROJECT_ROOT}\" && node .claude/hooks/config-protection.js",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "cd \"${PROJECT_ROOT}\" && node .claude/hooks/pre-tool-violation-gate.js",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "cd \"${PROJECT_ROOT}\" && node .claude/hooks/cross-ref-precheck.js",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "cd \"${PROJECT_ROOT}\" && node .claude/hooks/encoding-bom-guard.js",
